<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyName>HwVerify</AssemblyName>
        <RootNamespace>RtlSdrManager.Tools.HwVerify</RootNamespace>

        <!-- Contributor tool: never packed, never published to NuGet. -->
        <IsPackable>false</IsPackable>

        <!-- The console suppression check writes straight to a file descriptor, and the
             LibraryImport source generator emits unsafe marshalling code for that. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/RtlSdrManager/RtlSdrManager.csproj" />
    </ItemGroup>
</Project>
